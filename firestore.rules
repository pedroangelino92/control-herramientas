rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pedroangelino92@gmail.com'
      );
    }
    
    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin'
        ) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estado == 'activo'
      );
    }
    
    function isUserSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if isSignedIn();
    }

    // Colección de Usuarios
    match /usuarios/{userId} {
      // Cualquier usuario autenticado puede leer para mostrar nombres de técnicos y asignaciones
      allow read: if isSignedIn();
      
      // Permitir al usuario crear su propio perfil inicial con rol 'tecnico' y estado 'pendiente' (salvo el admin inicial)
      allow create: if isUserSelf(userId) && (
        isSuperAdmin() || (
          request.resource.data.rol == 'tecnico' &&
          request.resource.data.estado == 'pendiente'
        )
      );
      
      // Actualizar: solo un admin puede cambiar rol y estado. El propio usuario solo puede editar su perfil sin alterar rol ni estado.
      allow update: if isAdmin() || (
        isUserSelf(userId) && 
        request.resource.data.rol == resource.data.rol && 
        request.resource.data.estado == resource.data.estado
      );
      
      // Solo el superadministrador pedroangelino92@gmail.com puede eliminar cuentas
      allow delete: if isSuperAdmin();
    }

    // Colección de Herramientas
    match /herramientas/{herramientaId} {
      // Cualquier usuario autenticado puede consultar el inventario
      allow read: if isSignedIn();
      
      // Crear y editar: Administradores o técnicos aprobados durante préstamos
      allow create, update: if isSignedIn();
      
      // Eliminar: Solo el superadmin pedroangelino92@gmail.com
      allow delete: if isSuperAdmin();
    }

    // Colección de Categorías de Herramientas
    match /categorias/{categoriaId} {
      // Cualquier usuario autenticado puede consultar categorías
      allow read: if isSignedIn();
      // Crear, editar y eliminar: solo administradores
      allow create, update, delete: if isAdmin();
    }

    // Colección de Préstamos y Devoluciones
    match /prestamos/{prestamoId} {
      // Lectura para usuarios autenticados
      allow read: if isSignedIn();
      
      // Crear préstamos
      allow create: if isSignedIn();

      // Actualizar préstamos / devoluciones:
      // Regla estricta: un admin no puede auto-recibirse la devolución de una herramienta que retiró él mismo (salvo el superadmin)
      allow update: if isSuperAdmin() || (
        isAdmin() && (
          request.resource.data.estado != 'Devuelto' || request.auth.uid != resource.data.tecnicoUid
        )
      ) || (
        // Técnicos actualizando notas o estados de transferencia
        isSignedIn()
      );
      
      // Eliminar registros de préstamos: Solo el superadmin pedroangelino92@gmail.com
      allow delete: if isSuperAdmin();
    }

    // Colección de Solicitudes de Retiro
    match /solicitudes_retiro/{solicitudId} {
      // Lectura para usuarios autenticados
      allow read: if isSignedIn();
      
      // Crear: técnicos autenticados solicitan herramientas
      allow create: if isSignedIn();
      
      // Actualizar: Administradores autorizan/rechazan, técnicos pueden cancelar si está pendiente
      // Regla estricta: un admin NO puede auto-aprobarse una solicitud de retiro (salvo el superadmin pedroangelino92)
      allow update: if isSuperAdmin() || (
        isAdmin() && (
          request.resource.data.estado != 'Aprobada' || request.auth.uid != resource.data.tecnicoUid
        )
      ) || (
        isSignedIn() && request.auth.uid == resource.data.tecnicoUid && request.resource.data.estado == 'Cancelada'
      );

      // Eliminar: Solo el superadmin pedroangelino92@gmail.com
      allow delete: if isSuperAdmin();
    }

    // Colección de Transferencias en Campo entre Técnicos
    match /transferencias_campo/{transferenciaId} {
      // Lectura para usuarios autenticados
      allow read: if isSignedIn();
      
      // Crear traspaso en campo y confirmar recepción
      allow create, update: if isSignedIn();
      
      // Eliminar: Solo el superadmin pedroangelino92@gmail.com
      allow delete: if isSuperAdmin();
    }

    // Colección de Notificaciones del Sistema
    match /notificaciones/{notificacionId} {
      // Lectura, creación y actualización de estado de lectura para usuarios autenticados
      allow read, create, update: if isSignedIn();
      // Eliminar: Solo el superadmin pedroangelino92@gmail.com
      allow delete: if isSuperAdmin();
    }

    // Colección de Registro de Auditoría de Almacén
    match /auditoria/{auditoriaId} {
      // Solo administradores pueden consultar el historial de auditoría
      allow read: if isAdmin();
      // Cualquier usuario autenticado puede escribir eventos del sistema
      allow create: if isSignedIn();
      // No se permite modificar ni eliminar eventos de auditoría (inalterables) salvo el superadmin
      allow update: if false;
      allow delete: if isSuperAdmin();
    }
  }
}
